# --- Telegram bot ---
# Токен нового бота от @BotFather
BOT_TOKEN=123456:ABCDEF
# username бота без @ (используется для ссылки t.me/<username>?start=...)
BOT_USERNAME=my_kap_bot

# --- Локальный Telegram Bot API сервер (aiogram/telegram-bot-api) ---
# api_id / api_hash можно переиспользовать из cs2-demo-bot
TELEGRAM_API_ID=9970677
TELEGRAM_API_HASH=REDACTED-TG-API-HASH
# Корень API: для self-host через docker-compose это http://telegram-bot-api:8081
BOT_API_ROOT=http://telegram-bot-api:8081

# Прокси НУЖЕН ТОЛЬКО Bot API серверу (для доступа к Telegram).
# Сам сервер ходит к Telegram через локальный Bot API сервер — прокси ему не нужен.
PROXY_HOST=192.168.2.140
PROXY_PORT=1080

# --- Бэкенд ---
# Публичный адрес этого бэкенда (для botUrl / возврата плагину при необходимости)
PUBLIC_BACKEND_URL=http://localhost:3000
# Порт HTTP-сервера
PORT=3000
HOST=0.0.0.0

# --- База данных ---
DATABASE_URL=postgresql://kap:kap@postgres:5432/kap?schema=public

# --- Поведение авторизации ---
# true → self-serve: нажал Start → сразу выдаётся токен
AUTO_APPROVE=true
